{
	"name": "BrainyNotes",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.0",
			"better-auth": "1.7.1",
			"lucide-react": "^1.27.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.7",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"db:push": "turbo run db:push -F @BrainyNotes/db --",
		"db:studio": "turbo run db:studio -F @BrainyNotes/db --",
		"db:generate": "turbo run db:generate -F @BrainyNotes/db --",
		"db:migrate": "turbo run db:migrate -F @BrainyNotes/db --",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@BrainyNotes/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@BrainyNotes/config": "workspace:*",
		"@biomejs/biome": "^2.5.11",
		"@types/bun": "catalog:",
		"husky": "^9.1.7",
		"lint-staged": "^17.4.1",
		"turbo": "^2.10.12",
		"typescript": "catalog:"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "bun@1.3.14"
}
